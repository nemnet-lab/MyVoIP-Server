# ===== 起動するサービス =====
# caddy または nginx（リバースプロキシ）と、中継モードなら relay（中継用 Asterisk）をカンマ区切りで
COMPOSE_PROFILES=caddy,relay
# off   : HTTP のみ（外部に公開しない LAN・VPN 内での利用を前提）
# files : HTTPS。certs/fullchain.pem と certs/privkey.pem を使う
MYVOIP_TLS=off
HTTP_PORT=80
HTTPS_PORT=443

# アプリの「設定URL」になる値。iPhone（LAN・VPN 内）から到達できるアドレス
# 例: MYVOIP_TLS=off なら http://192.168.1.20 、files なら https://voip.example.lan
#     Tailscale だけで使うならこのサーバーの Tailnet アドレス（http://100.x.y.z）
MYVOIP_PUBLIC_URL=http://192.168.1.20

# API に接続できるクライアントのアドレス帯（カンマ区切り）。空なら制限しない
# 例: Tailnet だけに絞る → 100.64.0.0/10
MYVOIP_ALLOWED_CLIENT_CIDRS=

# ===== 秘密情報 =====
# PostgreSQL のパスワード（任意の長い文字列）
DB_PASSWORD=change-me
# SIP パスワード暗号化の鍵。作成: docker compose run --rm --no-deps myvoip gen-secret（または openssl rand -base64 32）
# 失うと登録済みの SIP パスワードを復号できなくなるのでバックアップする
MYVOIP_SECRET_KEY=

# ===== 中継モード（推奨） =====
# このサーバー内の中継用 Asterisk が MikoPBX に内線として常時登録し、iPhone はその Asterisk に登録する
RELAY_ENABLED=true
# MikoPBX の SIP の接続先（このサーバーから見たアドレス）
UPSTREAM_SIP_HOST=192.168.1.10
UPSTREAM_SIP_PORT=5060
# 中継用 Asterisk の SIP と RTP（ホストのポートを使う）
RELAY_SIP_PORT=5060
RELAY_RTP_START=10000
RELAY_RTP_END=10999
# Compose のネットワーク。中継用 Asterisk の ARI はこのゲートウェイだけで待ち受ける（LAN と重ならない範囲に）
MYVOIP_DOCKER_SUBNET=10.211.0.0/24
MYVOIP_DOCKER_GATEWAY=10.211.0.1

# ===== ARI =====
# 中継モード：中継用 Asterisk の ARI（http://<MYVOIP_DOCKER_GATEWAY>:8088/ari）。ユーザーとパスワードは自由に決める
# 直接モード：MikoPBX の ARI（MikoPBX 2024.1 は http://<MikoPBX>:8088/asterisk/ari）
ARI_URL=http://10.211.0.1:8088/ari
ARI_USER=myvoip
ARI_PASSWORD=
ARI_APP=myvoip

# ===== SIP（iPhone の登録先） =====
# 中継モード：このサーバーのアドレス（iPhone から届くもの。例 Tailnet のアドレス）
# 直接モード：MikoPBX のアドレス
SIP_DOMAIN=192.168.1.20
# udp / tcp / tls（中継モードは udp のみ。tls は SIP_DOMAIN と一致する証明書が必要）
SIP_TRANSPORT=udp
# 省略時は udp/tcp なら 5060、tls なら 5061
SIP_PROXY_PORT=
# 登録ドメインと接続先が異なる場合だけ指定（通常は空でよい）
SIP_PROXY_HOST=
# 音声の暗号化: optional（相手が対応すれば SRTP）/ mandatory（SRTP 必須）/ disabled（暗号化しない）
SIP_SRTP=optional

# ===== APNs =====
# Apple Developer の「Keys」で作った APNs 認証キーの Key ID（10文字）
APNS_KEY_ID=
# Apple Developer の Team ID（10文字）
APNS_TEAM_ID=
APNS_BUNDLE_ID=net.nemnet-lab.myvoip
# キー本体は secrets/apns.p8 に置く

# ===== 呼 =====
# 呼出時間（15〜60秒）
RING_TIMEOUT_SECONDS=30
# テスト着信で最初に流す音声（MikoPBX にある音声ファイル。日本語環境にもある vm-intro・one-moment-please など）
# 鳴らない場合はログに "playback failed" が出る。音声ファイルを使わないなら tone:ring;tonezone=jp
TEST_CALL_SOUND=sound:vm-intro
