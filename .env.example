# ===== リバースプロキシ =====
# caddy または nginx（Docker Compose のプロファイルで切り替える）
COMPOSE_PROFILES=caddy
# off   : HTTP のみ（外部に公開しない LAN・VPN 内での利用を前提）
# files : HTTPS。certs/fullchain.pem と certs/privkey.pem を使う
MYVOIP_TLS=off
HTTP_PORT=80
HTTPS_PORT=443

# アプリの「設定URL」になる値。iPhone（LAN・VPN 内）から到達できるアドレス
# 例: MYVOIP_TLS=off なら http://192.168.1.20 、files なら https://voip.example.lan
MYVOIP_PUBLIC_URL=http://192.168.1.20

# ===== 秘密情報 =====
# PostgreSQL のパスワード（任意の長い文字列）
DB_PASSWORD=change-me
# SIP パスワード暗号化の鍵。作成: docker compose run --rm --no-deps myvoip gen-secret（または openssl rand -base64 32）
# 失うと登録済みの SIP パスワードを復号できなくなるのでバックアップする
MYVOIP_SECRET_KEY=

# ===== MikoPBX（ARI） =====
# MikoPBX の LAN アドレスと Asterisk HTTP ポート（MikoPBX の AJAM/ARI 設定）
ARI_URL=http://192.168.1.10:8088/ari
ARI_USER=myvoip
ARI_PASSWORD=
ARI_APP=myvoip

# ===== SIP（アプリが登録する MikoPBX） =====
# iPhone（LAN・VPN 内）から到達できる MikoPBX のアドレス
SIP_DOMAIN=192.168.1.10
# udp / tcp / tls（tls は MikoPBX に SIP_DOMAIN と一致する証明書が必要）
SIP_TRANSPORT=udp
# 省略時は udp/tcp なら 5060、tls なら 5061
SIP_PROXY_PORT=
# 登録ドメインと接続先が異なる場合だけ指定（通常は空でよい）
SIP_PROXY_HOST=
# 音声の暗号化: optional（相手が対応すれば SRTP）/ mandatory（SRTP 必須）/ disabled（暗号化しない）
SIP_SRTP=optional

# ===== APNs =====
# Apple Developer の「Keys」で作った APNs 認証キーの Key ID（10文字）
APNS_KEY_ID=
# Apple Developer の Team ID（10文字）
APNS_TEAM_ID=
APNS_BUNDLE_ID=net.nemnet-lab.myvoip
# キー本体は secrets/apns.p8 に置く

# ===== 呼 =====
# 呼出時間（15〜60秒）
RING_TIMEOUT_SECONDS=30
# テスト着信で最初に流す音声（MikoPBX にある音声ファイル）
TEST_CALL_SOUND=sound:hello-world
